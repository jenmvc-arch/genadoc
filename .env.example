# Platform-level configuration only. User Gmail credentials are encrypted in
# the database and must never be added to this file.
DATABASE_URL=""
AUTH_SESSION_SECRET=""
EMAIL_CREDENTIAL_ENCRYPTION_KEY=""

# Supabase Auth. The publishable key is used by the server to exchange a user's
# email/password for a verified Supabase user; it is safe to distinguish from
# the server-only secret key below.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Server-only. Required for signed uploads and private Letterhead/export files.
# Never expose this value through VITE_* variables or browser code.
SUPABASE_SECRET_KEY=""

# Local/staging demo only. Keep false or unset in production.
ALLOW_DEMO_AUTH="false"

# Google OAuth application shared by the SaaS platform.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/email-connections/oauth/callback"
